UPSTREAM_SERVER=
JWKS_URL=$KEYCLOAK_FQDN/auth/realms/$REALM/protocol/openid-connect/certs

# Expected "aud" claim in access tokens. When unset, audience verification is skipped.
# JWT_AUDIENCE=account

# log server URL and TOKEN (JWT, see https://github.com/uwcirg/logserver#access-via-jwt)
# LOGSERVER_TOKEN=
# LOGSERVER_URL=
